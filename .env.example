# Copie este archivo como .env y ajuste los valores.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://matricula:cambiar_clave@localhost:5432/matricula

# Solo desarrollo: secreto con el que /auth/dev-token firma los tokens.
JWT_SECRET=cambiar-este-secreto-de-desarrollo

# Producción (obligatorio con NODE_ENV=production): proveedor de identidad OIDC.
# OIDC_ISSUER=https://login.ejemplo.edu.ec/realms/matricula
# OIDC_AUDIENCE=sistema-matricula
# OIDC_JWKS_URI=https://login.ejemplo.edu.ec/realms/matricula/protocol/openid-connect/certs

# Pruebas: base separada que npm test borra y recrea.
# TEST_DATABASE_URL=postgres://matricula:cambiar_clave@localhost:5432/matricula_test
