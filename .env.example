# Copy this file as .env and adjust the values.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://enrollment:change_me@localhost:5432/enrollment

# Development only: secret used by /auth/dev-token to sign tokens.
JWT_SECRET=change-this-development-secret

# Production (required with NODE_ENV=production): OIDC identity provider.
# OIDC_ISSUER=https://login.example.edu/realms/enrollment
# OIDC_AUDIENCE=enrollment-system
# OIDC_JWKS_URI=https://login.example.edu/realms/enrollment/protocol/openid-connect/certs

# Tests: separate database that npm test drops and recreates.
# TEST_DATABASE_URL=postgres://enrollment:change_me@localhost:5432/enrollment_test
