# PRODUCTION environment variables (copied to /etc/enrollment/enrollment.env).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://enrollment:STRONG_PASSWORD@localhost:5432/enrollment

# Institutional identity provider (OAuth 2.0 + OpenID Connect).
# If any of these three is missing, the application does NOT start.
OIDC_ISSUER=https://login.example.edu/realms/enrollment
OIDC_AUDIENCE=enrollment-system
OIDC_JWKS_URI=https://login.example.edu/realms/enrollment/protocol/openid-connect/certs
