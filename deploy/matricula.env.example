# Variables de entorno de PRODUCCIÓN (se copia a /etc/matricula/matricula.env).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://matricula:CLAVE_SEGURA@localhost:5432/matricula

# Proveedor de identidad institucional (OAuth 2.0 + OpenID Connect).
# Si falta cualquiera de estas tres, la aplicación NO arranca.
OIDC_ISSUER=https://login.ejemplo.edu.ec/realms/matricula
OIDC_AUDIENCE=sistema-matricula
OIDC_JWKS_URI=https://login.ejemplo.edu.ec/realms/matricula/protocol/openid-connect/certs
