# Servicio systemd del sistema de matrícula (ADR-05).
# Instalación:
#   sudo useradd --system --home /opt/sistema-matricula --shell /usr/sbin/nologin matricula
#   sudo cp -r . /opt/sistema-matricula && cd /opt/sistema-matricula && sudo npm ci --omit=dev
#   sudo mkdir -p /etc/matricula && sudo cp deploy/matricula.env.example /etc/matricula/matricula.env
#   sudo chmod 600 /etc/matricula/matricula.env   # contiene la clave de la base
#   sudo cp deploy/matricula.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now matricula
#   journalctl -u matricula -f                     # ver los registros

[Unit]
Description=Sistema de Matricula Universitaria (Express)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=matricula
Group=matricula
WorkingDirectory=/opt/sistema-matricula
EnvironmentFile=/etc/matricula/matricula.env
ExecStart=/usr/bin/node backend/server.js
Restart=on-failure
RestartSec=5

# Endurecimiento: el proceso no puede escribir en el sistema ni escalar privilegios.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
